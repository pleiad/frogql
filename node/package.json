{
  "name": "frogql",
  "version": "0.2.8",
  "description": "froGQL — embedded GQL graph database with ISO GQL path patterns (Rust core, Node.js bindings via napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "author": "Matías Toro <mtoro.cl@gmail.com>",
  "homepage": "https://github.com/pleiad/frogql#readme",
  "bugs": "https://github.com/pleiad/frogql/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleiad/frogql.git",
    "directory": "node"
  },
  "keywords": [
    "gql",
    "graph",
    "database",
    "query",
    "ltj",
    "leapfrog-triejoin",
    "iso-gql",
    "napi-rs"
  ],
  "engines": {
    "node": ">= 16"
  },
  "napi": {
    "binaryName": "frogql",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "optionalDependencies": {
    "frogql-darwin-arm64": "0.2.8",
    "frogql-darwin-x64": "0.2.8",
    "frogql-linux-arm64-gnu": "0.2.8",
    "frogql-linux-x64-gnu": "0.2.8",
    "frogql-win32-x64-msvc": "0.2.8"
  }
}
